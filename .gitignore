.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.DS_Store
*.log
data_cache/
# reports: session artifacts stay private, but the FT/CBS curation reports are published (the
# dashboards link them on GitHub). NB excluding `data/reports/` itself would make the negation a
# no-op -- git cannot re-include a file inside an excluded DIRECTORY -- hence the /* form.
data/reports/*
!data/reports/*-curation.md
data/wave_history.csv
data/news/
data/forward_corpus/
data/backtest/
data/curator_latest.json
data/curation_history.csv
# curator run payloads: 1.8G across ~144k files in ~99 run dirs. Derived data, regenerated by
# backtest_sdk.py at API cost, not source. Tracking was already abandoned in commits 637ad6cb and
# ea03b4c3; this rule makes that decision explicit so `git add .` can't sweep 1.8G into a commit.
data/curator_runs/
data/forward_test/
data/backtest_curator_*/sandbox/
# data/dashboard.html removed — docs/index.html is the single dashboard now (commit 53d4929)

# personal data — never push
.env
gcp-key.json
.gcp/
data/news_ab/
.claude/settings.local.json
# Leading slash anchors these to the repo ROOT only. Without it the pattern matches at any depth and
# would also swallow the tracked starter templates in examples/.
/holdings.csv
/holdings.csv.pre-split.bak
/watchlist.csv
/investor_profile.md
# The curated retrieval recipe: source tiering and per-wave search terms. Held back so the tuned
# versions stay private; slim starter versions ship in examples/ and are tracked.
/news_sources.md
/retrieval_config.json
data/snapshots.csv
data/recommendations.csv
data/thesis_baseline.json
data/curator_runs/live/

# local-only holding pen: stale content we want to keep around but NOT push to git
archived/
